---
layout: layouts/base.njk
section: work
---

<article>
  <h1>{{ title }}</h1>
  <p>
    <small>
      {% if client %}{{ client }}{% endif %}{% if role %} · {{ role }}{% endif %}{% if year %} · {{ year }}{% endif %}
    </small>
  </p>

  {{ content | safe }}

  {% if tags %}
    <p>
    {% for tag in tags %}
      {%- if tag != "work" -%}
        {% set tagUrl %}/tags/{{ tag }}/{% endset %}
        <a href="{{ tagUrl | url }}" rel="tag">{{ tag }}</a>
      {%- endif -%}
    {% endfor %}
    </p>
  {% endif %}
</article>

<nav>
  <a href="{{ '/work/' | url }}">← All work</a>
</nav>
